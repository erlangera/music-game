{
  "name": "vue3-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
